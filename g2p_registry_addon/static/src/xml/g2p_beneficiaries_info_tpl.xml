<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="g2p_beneficiaries_info_tpl">
        <!-- Domain filter -->
        <div class="mb-3">
            <DomainSelector
                resModel="props.resModel"
                domain="state.domain"
                update.bind="onDomainChange"
                readonly="false"
                isDebugMode="!!env.debug"
                className="'o_edit_mode'"
            />
        </div>

        <!-- Search button -->
        <div class="mb-4">
            <button type="button" class="btn btn-primary px-4" t-on-click="searchRegistrants">
                <i class="fa fa-search me-2"/>Search
            </button>
        </div>

        <!-- Results area -->
        <div class="g2p-beneficiaries">
            <t t-if="state.searched">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="mb-0 text-muted fw-semibold">
                        <i class="fa fa-users me-2"/>
                        <t t-esc="state.title"/>
                    </h5>
                    <span class="badge bg-secondary fs-6">
                        Page <t t-esc="state.page"/> of <t t-esc="state.totalPages"/>
                    </span>
                </div>
            </t>

            <div class="table-responsive rounded border">
                <table class="table table-hover table-striped align-middle mb-0" style="font-size: 0.9rem;">
                    <thead class="table-dark">
                        <tr>
                            <!-- Individual Header -->
                            <t t-if="state.target_registry === 'individual'">
                                <th class="px-3 py-2">Internal ID</th>
                                <th class="px-3 py-2">Full Name</th>
                                <th class="px-3 py-2">Gender</th>
                                <th class="px-3 py-2">Age</th>
                                <th class="px-3 py-2">District</th>
                                <th class="px-3 py-2">Block</th>
                                <th class="px-3 py-2">Village</th>
                                <th class="px-3 py-2">Mobile</th>
                                <th class="px-3 py-2">Aadhaar</th>
                            </t>
                            <!-- Household Header -->
                            <t t-elif="state.target_registry === 'household'">
                                <th class="px-3 py-2">Internal ID</th>
                                <th class="px-3 py-2">Head Name</th>
                                <th class="px-3 py-2 text-center">Total Size</th>
                                <th class="px-3 py-2">Ration Card #</th>
                                <th class="px-3 py-2">Card Type</th>
                                <th class="px-3 py-2">District</th>
                                <th class="px-3 py-2">Block</th>
                                <th class="px-3 py-2">Village</th>
                            </t>
                            <!-- Farmer Header -->
                            <t t-elif="state.target_registry === 'farmer'">
                                <th class="px-3 py-2">Farmer ID</th>
                                <th class="px-3 py-2">Farmer Name</th>
                                <th class="px-3 py-2">Aadhaar #</th>
                                <th class="px-3 py-2">Gender</th>
                                <th class="px-3 py-2">DOB</th>
                                <th class="px-3 py-2">Mobile</th>
                                <th class="px-3 py-2">Standing Crops</th>
                                <th class="px-3 py-2 text-center">Land (Acres)</th>
                                <th class="px-3 py-2">Ownership</th>
                                <th class="px-3 py-2 text-center">PM-KISAN</th>
                                <th class="px-3 py-2 text-center">PMFBY</th>
                                <th class="px-3 py-2">District</th>
                                <th class="px-3 py-2">Block</th>
                                <th class="px-3 py-2">Village</th>
                            </t>
                            <!-- Student Header -->
                            <t t-elif="state.target_registry === 'student'">
                                <th class="px-3 py-2">Student ID</th>
                                <th class="px-3 py-2">Student Name</th>
                                <th class="px-3 py-2">Aadhaar #</th>
                                <th class="px-3 py-2">Gender</th>
                                <th class="px-3 py-2">DOB</th>
                                <th class="px-3 py-2">School</th>
                                <th class="px-3 py-2">Grade</th>
                                <th class="px-3 py-2">District</th>
                                <th class="px-3 py-2">Block</th>
                                <th class="px-3 py-2">State</th>
                                <th class="px-3 py-2 text-center">Attendance</th>
                                <th class="px-3 py-2 text-center">Scholarship</th>
                            </t>
                            <!-- Group Header -->
                            <t t-elif="state.target_registry === 'group'">
                                <th class="px-3 py-2">Internal ID</th>
                                <th class="px-3 py-2">Group Name</th>
                                <th class="px-3 py-2">SHG ID</th>
                                <th class="px-3 py-2">Key Member</th>
                                <th class="px-3 py-2">Grading</th>
                                <th class="px-3 py-2 text-end">CCL Limit</th>
                                <th class="px-3 py-2">District</th>
                                <th class="px-3 py-2">Block</th>
                                <th class="px-3 py-2">Village</th>
                            </t>
                            <!-- Gramstack Household Header -->
                            <t t-elif="state.target_registry === 'gramstackhousehold'">
                                <th class="px-2 py-1 text-nowrap">Household ID</th>
                                <th class="px-2 py-1 text-nowrap">Member Name</th>
                                <th class="px-2 py-1 text-nowrap">SHG Name</th>
                                <th class="px-2 py-1 text-nowrap">SHG ID</th>
                                <th class="px-2 py-1 text-nowrap">LokOS Member ID</th>
                                <th class="px-2 py-1 text-nowrap">SHG Role</th>
                                <th class="px-2 py-1 text-nowrap">Grading</th>
                                <th class="px-2 py-1 text-nowrap">Village Org (VO)</th>
                                <th class="px-2 py-1 text-nowrap">CLF Name</th>
                                <th class="px-2 py-1 text-end text-nowrap">Savings (₹)</th>
                                <th class="px-2 py-1 text-end text-nowrap">Int. Loan (₹)</th>
                                <th class="px-2 py-1 text-end text-nowrap">CCL Limit (₹)</th>
                                <th class="px-2 py-1 text-end text-nowrap">CCL Used (₹)</th>
                                <th class="px-2 py-1 text-nowrap">Bank A/C No</th>
                                <th class="px-2 py-1 text-nowrap">IFSC</th>
                                <th class="px-2 py-1 text-nowrap">Aadhaar</th>
                                <th class="px-2 py-1 text-nowrap">Mobile</th>
                                <th class="px-2 py-1 text-nowrap">Rel to HoH</th>
                                <th class="px-2 py-1 text-nowrap">Join Date</th>
                                <th class="px-2 py-1 text-nowrap">Village</th>
                                <th class="px-2 py-1 text-nowrap">Block</th>
                                <th class="px-2 py-1 text-nowrap">District</th>
                                <th class="px-2 py-1 text-nowrap">LokOS HH ID</th>
                                <th class="px-2 py-1 text-center text-nowrap">Status</th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="state.records and state.records.length">
                            <t t-foreach="state.records" t-as="record" t-key="record.id or record.internal_record_id">
                                <tr>
                                    <!-- Individual Row -->
                                    <t t-if="state.target_registry === 'individual'">
                                        <td class="px-3 py-2 fw-semibold text-primary"><t t-esc="record.internal_record_id"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.full_name"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.gender"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.estimated_age"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.district"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.block"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.village"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.mobile_number"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.aadhaar_number"/></td>
                                    </t>
                                    <!-- Household Row -->
                                    <t t-elif="state.target_registry === 'household'">
                                        <td class="px-3 py-2 fw-semibold text-primary"><t t-esc="record.internal_record_id"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.household_head_name"/></td>
                                        <td class="px-3 py-2 text-center"><t t-esc="record.size_total"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.ration_card_number"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.ration_card_type"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.district"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.block"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.village"/></td>
                                    </t>
                                    <!-- Farmer Row -->
                                    <t t-elif="state.target_registry === 'farmer'">
                                        <td class="px-3 py-2 fw-semibold text-primary"><t t-esc="record.farmer_id or record.internal_record_id"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.name or record.farmer_name"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.aadhaar_number or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.gender or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.date_of_birth or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.mobile_number or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.crop_type or '-'"/></td>
                                        <td class="px-3 py-2 text-center"><t t-esc="record.land_area_acres or record.land_area or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.land_ownership_type or '-'"/></td>
                                        <td class="px-3 py-2 text-center">
                                            <span t-attf-class="badge #{record.pm_kisan_enrolled ? 'bg-success' : 'bg-secondary'}">
                                                <t t-esc="record.pm_kisan_enrolled ? 'Yes' : 'No'"/>
                                            </span>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <span t-attf-class="badge #{record.pmfby_enrolled ? 'bg-success' : 'bg-secondary'}">
                                                <t t-esc="record.pmfby_enrolled ? 'Yes' : 'No'"/>
                                            </span>
                                        </td>
                                        <td class="px-3 py-2"><t t-esc="record.district or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.block or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.village or '-'"/></td>
                                    </t>
                                    <!-- Student Row -->
                                    <t t-elif="state.target_registry === 'student'">
                                        <td class="px-3 py-2 fw-semibold text-primary"><t t-esc="record.student_id or record.internal_record_id"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.name"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.aadhaar_number or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.gender or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.date_of_birth or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.school_name or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.class_grade or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.district or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.block or '-'"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.state or '-'"/></td>
                                        <td class="px-3 py-2 text-center">
                                            <t t-if="record.attendance_percentage !== null and record.attendance_percentage !== undefined">
                                                <t t-esc="record.attendance_percentage"/>%
                                            </t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <span t-attf-class="badge #{record.scholarship_status === 'Active' ? 'bg-success' : 'bg-secondary'}">
                                                <t t-esc="record.scholarship_status or 'None'"/>
                                            </span>
                                        </td>
                                    </t>
                                    <!-- Group Row -->
                                    <t t-elif="state.target_registry === 'group'">
                                        <td class="px-3 py-2 fw-semibold text-primary"><t t-esc="record.internal_record_id"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.group_name"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.shg_id"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.key_member_name"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.shg_grading"/></td>
                                        <td class="px-3 py-2 text-end"><t t-esc="record.ccl_limit"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.district"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.block"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.village"/></td>
                                    </t>
                                    <!-- Gramstack Household Row -->
                                    <t t-elif="state.target_registry === 'gramstackhousehold'">
                                        <td class="px-2 py-1 fw-semibold text-primary text-nowrap"><t t-esc="record.household_id or record.functional_record_id or record.house_reference_no or record.internal_record_id"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.member_name or record.applicant_name or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.shg_name or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.shg_id or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.member_id or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.shg_role or '-'"/></td>
                                        <td class="px-2 py-1 text-center text-nowrap"><span class="badge bg-secondary"><t t-esc="record.shg_grading or '-'"/></span></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.vo_name or record.vo_id or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.clf_name or record.clf_id or '-'"/></td>
                                        <td class="px-2 py-1 text-end text-nowrap"><t t-esc="record.monthly_savings_amount or 0"/></td>
                                        <td class="px-2 py-1 text-end text-nowrap"><t t-esc="record.internal_loan_outstanding or 0"/></td>
                                        <td class="px-2 py-1 text-end text-nowrap"><t t-esc="record.ccl_limit or 0"/></td>
                                        <td class="px-2 py-1 text-end text-nowrap"><t t-esc="record.ccl_utilized or 0"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.bank_account_no or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.ifsc or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.aadhaar_number or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.mobile_number or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.relationship_to_hoh or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.shg_join_date or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.village or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.block or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.district or '-'"/></td>
                                        <td class="px-2 py-1 text-nowrap"><t t-esc="record.lokos_id or '-'"/></td>
                                        <td class="px-2 py-1 text-center text-nowrap">
                                            <span class="badge bg-info"><t t-esc="record.status or 'APPLIED'"/></span>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="23" class="text-center text-muted py-4">
                                    <i class="fa fa-inbox fa-2x d-block mb-2"/>
                                    No records found.
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Pager -->
            <t t-if="state.searched and state.totalPages > 1">
                <div class="d-flex align-items-center justify-content-center gap-3 mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                        t-on-click="prevPage" t-att-disabled="state.page &lt;= 1">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <span class="text-muted small">
                        Page <strong><t t-esc="state.page"/></strong> of <strong><t t-esc="state.totalPages"/></strong>
                    </span>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                        t-on-click="nextPage" t-att-disabled="state.page &gt;= state.totalPages">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>
            </t>
        </div>
    </t>
</templates>
