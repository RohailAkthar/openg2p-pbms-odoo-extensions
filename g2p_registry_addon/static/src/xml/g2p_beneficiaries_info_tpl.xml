<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="g2p_beneficiaries_info_tpl">
        <!-- Domain filter -->
        <div class="mb-3">
            <DomainSelector
                resModel="props.resModel"
                domain="state.domain"
                update.bind="onDomainChange"
                readonly="false"
                isDebugMode="!!env.debug"
                className="'o_edit_mode'"
            />
        </div>

        <!-- Search button -->
        <div class="mb-4">
            <button type="button" class="btn btn-primary px-4" t-on-click="searchRegistrants">
                <i class="fa fa-search me-2"/>Search
            </button>
        </div>

        <!-- Results area -->
        <div class="g2p-beneficiaries">
            <t t-if="state.searched">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="mb-0 text-muted fw-semibold">
                        <i class="fa fa-users me-2"/>
                        <t t-esc="state.title"/>
                    </h5>
                    <span class="badge bg-secondary fs-6">
                        Page <t t-esc="state.page"/> of <t t-esc="state.totalPages"/>
                    </span>
                </div>
            </t>

            <div class="table-responsive rounded border">
                <table class="table table-hover table-striped align-middle mb-0" style="font-size: 0.9rem;">
                    <thead class="table-dark">
                        <tr>
                            <t t-if="state.target_registry === 'household'">
                                <th class="px-3 py-2">Functional ID</th>
                                <th class="px-3 py-2">Household Head</th>
                                <th class="px-3 py-2">Headship Type</th>
                                <th class="px-3 py-2 text-center">Total Size</th>
                                <th class="px-3 py-2">Dwelling Type</th>
                                <th class="px-3 py-2">Water Source</th>
                                <th class="px-3 py-2">Sanitation</th>
                                <th class="px-3 py-2">Ward / Location</th>
                                <th class="px-3 py-2 text-center">Status</th>
                            </t>
                            <t t-elif="state.target_registry === 'individual'">
                                <th class="px-3 py-2">Functional ID</th>
                                <th class="px-3 py-2">Full Name</th>
                                <th class="px-3 py-2">Gender</th>
                                <th class="px-3 py-2 text-center">Age</th>
                                <th class="px-3 py-2">Relation to Head</th>
                                <th class="px-3 py-2">Disability</th>
                                <th class="px-3 py-2 text-center">PLW</th>
                                <th class="px-3 py-2">Primary Livelihood</th>
                                <th class="px-3 py-2 text-center">Status</th>
                            </t>
                            <t t-elif="state.target_registry === 'families'">
                                <th class="px-3 py-2">Functional ID</th>
                                <th class="px-3 py-2">Family Name</th>
                                <th class="px-3 py-2">Type of Housing</th>
                                <th class="px-3 py-2">House Condition</th>
                                <th class="px-3 py-2">Sanitation Condition</th>
                                <th class="px-3 py-2">Water Access</th>
                                <th class="px-3 py-2">Electricity Access</th>
                                <th class="px-3 py-2">Ethnic Group</th>
                                <th class="px-3 py-2 text-center"># Children</th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="state.records and state.records.length">
                            <t t-foreach="state.records" t-as="record" t-key="record.id">
                                <tr>
                                    <t t-if="state.target_registry === 'household'">
                                        <td class="px-3 py-2 fw-semibold text-primary">
                                            <t t-esc="record.functional_record_id"/>
                                        </td>
                                        <td class="px-3 py-2"><t t-esc="record.household_head_name"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.headship_type"/></td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="badge bg-info text-dark">
                                                <t t-esc="record.size_total"/>
                                            </span>
                                        </td>
                                        <td class="px-3 py-2"><t t-esc="record.dwelling_type"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.water_source_type"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.sanitation_type"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.geo_lowest_level_value_id"/></td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="badge bg-success">
                                                <t t-esc="record.record_status or 'ACTIVE'"/>
                                            </span>
                                        </td>
                                    </t>
                                    <t t-elif="state.target_registry === 'individual'">
                                        <td class="px-3 py-2 fw-semibold text-primary">
                                            <t t-esc="record.functional_record_id"/>
                                        </td>
                                        <td class="px-3 py-2"><t t-esc="record.full_name"/></td>
                                        <td class="px-3 py-2 text-capitalize"><t t-esc="record.gender"/></td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="badge bg-secondary">
                                                <t t-esc="record.estimated_age"/>
                                            </span>
                                        </td>
                                        <td class="px-3 py-2"><t t-esc="record.relationship_to_head"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.disability_status"/></td>
                                        <td class="px-3 py-2 text-center">
                                            <span t-attf-class="badge #{record.plw_status ? 'bg-warning text-dark' : 'bg-light text-muted border'}">
                                                <t t-esc="record.plw_status ? 'YES' : 'NO'"/>
                                            </span>
                                        </td>
                                        <td class="px-3 py-2"><t t-esc="record.primary_livelihood"/></td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="badge bg-success">
                                                <t t-esc="record.record_status or 'ACTIVE'"/>
                                            </span>
                                        </td>
                                    </t>
                                    <t t-elif="state.target_registry === 'families'">
                                        <td class="px-3 py-2 fw-semibold text-primary">
                                            <t t-esc="record.functional_record_id"/>
                                        </td>
                                        <td class="px-3 py-2"><t t-esc="record.family_name"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.type_of_housing"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.house_condition"/></td>
                                        <td class="px-3 py-2"><t t-esc="record.sanitation_condition"/></td>
                                        <td class="px-3 py-2 text-center">
                                            <span t-attf-class="badge #{record.water_access ? 'bg-success' : 'bg-danger'}">
                                                <t t-esc="record.water_access"/>
                                            </span>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <span t-attf-class="badge #{record.electricity_access ? 'bg-success' : 'bg-danger'}">
                                                <t t-esc="record.electricity_access"/>
                                            </span>
                                        </td>
                                        <td class="px-3 py-2"><t t-esc="record.ethnic_group"/></td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="badge bg-info text-dark">
                                                <t t-esc="record.no_of_children"/>
                                            </span>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="fa fa-inbox fa-2x d-block mb-2"/>
                                    No records found.
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Pager -->
            <t t-if="state.searched and state.totalPages > 1">
                <div class="d-flex align-items-center justify-content-center gap-3 mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                        t-on-click="prevPage" t-att-disabled="state.page &lt;= 1">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <span class="text-muted small">
                        Page <strong><t t-esc="state.page"/></strong> of <strong><t t-esc="state.totalPages"/></strong>
                    </span>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                        t-on-click="nextPage" t-att-disabled="state.page &gt;= state.totalPages">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>
            </t>
        </div>
    </t>
</templates>
