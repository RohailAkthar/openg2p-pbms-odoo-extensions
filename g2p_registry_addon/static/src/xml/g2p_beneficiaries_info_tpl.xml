<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="g2p_beneficiaries_info_tpl">
        <div>
            <DomainSelector
                resModel="props.resModel"
                domain="state.domain"
                update.bind="onDomainChange"
                readonly="false"
                isDebugMode="!!env.debug"
                className="'o_edit_mode'"
            />
        </div>
        <div class="o_x2m_control_panel d-empty-none mb-4">
            <button type="button" class="btn btn-secondary" t-on-click="searchRegistrants">
                <i class="fa fa-search"/>
            </button>
        </div>
        <div class="g2p-beneficiaries" style="font-size: 18px;">
            <!-- Search input with search and arch buttons -->
            <t t-if="state.searched">
                <h3><t t-esc="state.title"/></h3>
            </t>
            <table class="table table-hover g2p-beneficiaries-table">
                <thead>
                    <tr>
                        <th style="width: 40px;"></th> <!-- Toggle arrow -->
                        <t t-if="state.target_registry === 'individual'">
                            <th class="text-center">Name</th>
                            <th class="text-center">Gender</th>
                            <th class="text-center">DOB</th>
                            <th class="text-center">Region</th>
                            <th class="text-center">District</th>
                            <th class="text-center">Zan ID</th>
                            <th class="text-center">Address</th>
                            <th class="text-center">Phone</th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="state.records" t-as="record" t-key="record.id">
                        <!-- Main Information Row -->
                        <tr t-on-click="() => this.toggleDetails(record.id)" style="cursor: pointer;">
                            <td class="text-center align-middle">
                                <i t-attf-class="fa #{state.expandedRecordId === record.id ? 'fa-chevron-down' : 'fa-chevron-right'} text-primary"/>
                            </td>
                            <t t-if="state.target_registry === 'individual'">
                                <td class="align-middle font-weight-bold text-center"><t t-esc="record.name"/></td>
                                <td class="align-middle text-center">
                                    <span t-attf-class="badge #{record.gender === 'Male' ? 'badge-info' : record.gender === 'Female' ? 'badge-danger' : 'badge-secondary'} p-2">
                                        <t t-esc="record.gender"/>
                                    </span>
                                </td>
                                <td class="align-middle text-center"><t t-esc="record.birthdate"/></td>
                                <td class="align-middle text-center"><t t-esc="record.region_name"/></td>
                                <td class="align-middle text-center"><t t-esc="record.district_name"/></td>
                                <td class="align-middle text-monospace text-muted text-center"><t t-esc="record.benf_zan_id"/></td>
                                <td class="align-middle text-center"><t t-esc="record.street"/></td>
                                <td class="align-middle text-center"><t t-esc="record.phone"/></td>
                            </t>
                        </tr>
                        <!-- Detailed Nominee Row (Expandable) -->
                        <tr t-if="state.expandedRecordId === record.id" class="bg-light">
                            <td colspan="10" class="g2p-expanded-cell">
                                <div class="p-3 border rounded shadow-sm bg-white m-2">
                                    <div class="row">
                                        <!-- Beneficiary Details Column -->
                                        <div class="col-md-6 border-right">
                                            <h6 class="text-primary border-bottom pb-1 mb-3"><i class="fa fa-info-circle mr-2"/>Beneficiary Details</h6>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Do you have any disability?</div>
                                                        <div class="font-weight-bold"><t t-esc="record.disability or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Are you receiving any allowance?</div>
                                                        <div class="font-weight-bold"><t t-esc="record.is_receiving_allowance or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Do you have health insurance?</div>
                                                        <div class="font-weight-bold"><t t-esc="record.has_health_insurance or '-'"/></div>
                                                    </div>
                                                    <hr class="my-2"/>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Do you have other ID?</div>
                                                        <div class="font-weight-bold"><t t-esc="record.other_id_available or '-'"/></div>
                                                    </div>
                                                    <t t-if="record.other_id_available === 'yes' or record.other_id_available === 'True'">
                                                         <div class="mb-3 ml-2">
                                                            <div class="text-uppercase text-muted small">Other ID Type</div>
                                                            <div class="font-weight-bold"><t t-esc="record.other_id_type or '-'"/></div>
                                                         </div>
                                                         <div class="mb-3 ml-2">
                                                            <div class="text-uppercase text-muted small">Other ID Name</div>
                                                            <div class="font-weight-bold"><t t-esc="record.other_id_name or '-'"/></div>
                                                         </div>
                                                         <div class="mb-3 ml-2">
                                                            <div class="text-uppercase text-muted small">Other ID Number</div>
                                                            <div class="font-weight-bold"><t t-esc="record.other_id_number or '-'"/></div>
                                                         </div>
                                                    </t>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Payment Mode</div>
                                                        <div class="font-weight-bold"><t t-esc="record.payment_mode or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Bank</div>
                                                        <div class="font-weight-bold"><t t-esc="record.bank_name or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Account</div>
                                                        <div class="font-weight-bold"><t t-esc="record.account_num or '-'"/> (<t t-esc="record.account_name or '-'"/>)</div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Mobile Wallet</div>
                                                        <div class="font-weight-bold"><t t-esc="record.mobile_wallet or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Post Code</div>
                                                        <div class="font-weight-bold"><t t-esc="record.benf_post_code or '-'"/></div>
                                                    </div>
                                                    <hr class="my-2"/>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Other Pension</div>
                                                        <div class="font-weight-bold"><t t-esc="record.other_pension or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Scheme Name</div>
                                                        <div class="font-weight-bold"><t t-esc="record.scheme_name or '-'"/></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Nominee Information Column -->
                                        <div class="col-md-6">
                                            <h6 class="text-primary border-bottom pb-1 mb-3"><i class="fa fa-user-circle mr-2"/>Nominee Information</h6>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Name</div>
                                                        <div class="font-weight-bold"><t t-esc="record.nominee_first_name or '-'"/> <t t-esc="record.nominee_last_name or ''"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Gender</div>
                                                        <div class="font-weight-bold"><t t-esc="record.nominee_gender or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Relation</div>
                                                        <div class="font-weight-bold"><t t-esc="record.nominee_rel_benf or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Zan ID</div>
                                                        <div class="font-weight-bold"><t t-esc="record.nominee_zanid or '-'"/></div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Mobile</div>
                                                        <div class="font-weight-bold"><t t-esc="record.nominee_mobile or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Location</div>
                                                        <div class="font-weight-bold"><t t-esc="record.nominee_region or '-'"/> / <t t-esc="record.nominee_district or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Shehia</div>
                                                        <div class="font-weight-bold"><t t-esc="record.nominee_shehia or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Address</div>
                                                        <div class="font-weight-bold"><t t-esc="record.nominee_house_street or '-'"/></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <div class="text-uppercase text-muted small">Post Code</div>
                                                        <div class="font-weight-bold"><t t-esc="record.nominee_post_code or '-'"/></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

                <t t-if="state.searched">
                    <div class="o_beneficiary_pager">
                        <button type="button" class="btn btn-secondary" t-on-click="prevPage" t-att-disabled="state.page &lt;= 1">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <span>
                            <t t-esc="state.page"/> / <t t-esc="state.totalPages"/>
                        </span>
                        <button type="button" class="btn btn-secondary" t-on-click="nextPage" t-att-disabled="state.page &gt;= state.totalPages">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>
                </t>
        </div>
    </t>
</templates>
