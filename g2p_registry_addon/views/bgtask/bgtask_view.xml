<odoo>
  <record id="view_g2p_eligibility_summary_wizard_form_inherit_beneficiaries" model="ir.ui.view">
    <field name="name">g2p.bgtask.summary.wizard.form.inherit.beneficiaries</field>
    <field name="model">g2p.bgtask.summary.wizard</field>
    <field name="inherit_id" ref="g2p_pbms.view_g2p_eligibility_summary_wizard_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[.//field[@name='target_registry']]/group" position="after">
        <!-- Only one beneficiary_search field is shown based on registry type -->
        <group name="beneficiary_search_farmer" invisible="target_registry != 'farmer'">
          <widget name="g2p_beneficiaries_widget" model="g2p.registry.farmer" id="farmer_beneficiary_search_widget"/>
        </group>
        <group name="beneficiary_search_student" invisible="target_registry != 'student'">
          <widget name="g2p_beneficiaries_widget" model="g2p.registry.student" id="student_beneficiary_search_widget"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>