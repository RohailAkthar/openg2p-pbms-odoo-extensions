<odoo>
  <record id="view_g2p_eligibility_summary_wizard_form_inherit_beneficiaries" model="ir.ui.view">
    <field name="name">g2p.bgtask.summary.wizard.form.inherit.beneficiaries</field>
    <field name="model">g2p.bgtask.summary.wizard</field>
    <field name="inherit_id" ref="g2p_pbms.view_g2p_eligibility_summary_wizard_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[.//field[@name='target_registry']]/group" position="after">
        <!-- Beneficiary search widget dynamically shown based on target registry -->
        <group name="beneficiary_search_individual" invisible="target_registry != 'individual'">
          <widget name="g2p_beneficiaries_widget" model="g2p.individual.registry" id="individual_beneficiary_search_widget"/>
        </group>
        <group name="beneficiary_search_household" invisible="target_registry != 'household'">
          <widget name="g2p_beneficiaries_widget" model="g2p.household.registry" id="household_beneficiary_search_widget"/>
        </group>
        <group name="beneficiary_search_farmer" invisible="target_registry != 'farmer'">
          <widget name="g2p_beneficiaries_widget" model="g2p.farmer.registry" id="farmer_beneficiary_search_widget"/>
        </group>
        <group name="beneficiary_search_student" invisible="target_registry != 'student'">
          <widget name="g2p_beneficiaries_widget" model="g2p.student.registry" id="student_beneficiary_search_widget"/>
        </group>
        <group name="beneficiary_search_group" invisible="target_registry != 'group'">
          <widget name="g2p_beneficiaries_widget" model="g2p.group.registry" id="group_beneficiary_search_widget"/>
        </group>
        <group name="beneficiary_search_gramstackhousehold" invisible="target_registry != 'gramstackhousehold'">
          <widget name="g2p_beneficiaries_widget" model="g2p.gramstack.household.registry" id="gramstackhousehold_beneficiary_search_widget"/>
        </group>
      </xpath>

      <!-- Hide Disbursement Rules tab -->
      <xpath expr="//page[.//field[@name='priority_rule_ids']]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_g2p_disbursement_cycle_form_inherit_hide_disbursement_rules" model="ir.ui.view">
    <field name="name">g2p.disbursement.cycle.form.inherit.hide.disbursement.rules</field>
    <field name="model">g2p.disbursement.cycle</field>
    <field name="inherit_id" ref="g2p_pbms.view_g2p_disbursement_cycle_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[.//field[@name='priority_rule_ids']]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>
</odoo>