<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_priority_rule_definition_form_inherit" model="ir.ui.view">
        <field name="name">g2p.priority.rule.definition.form.inherit</field>
        <field name="model">g2p.priority.rule.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_priority_rule_definition_form"/>
        <field name="arch" type="xml">

            <!-- Inject domain widgets inside the <group> -->
            <xpath expr="//form/sheet/group" position="inside">

                <!-- Domain widget for the 'families' type -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.families', 'allowed_fields': ['priority_rank']}"
                       invisible="target_registry != 'families'"/>

                <!-- Domain widget for the 'household' type -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.household'}"
                       invisible="target_registry != 'household'"/>

                <!-- Domain widget for the 'individual' type -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.individual'}"
                       invisible="target_registry != 'individual'"/>

            </xpath>
        </field>
    </record>
</odoo>
