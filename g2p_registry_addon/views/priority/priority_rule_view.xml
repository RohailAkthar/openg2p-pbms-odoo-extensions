<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_priority_rule_definition_form_inherit" model="ir.ui.view">
        <field name="name">g2p.priority.rule.definition.form.inherit</field>
        <field name="model">g2p.priority.rule.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_priority_rule_definition_form"/>
        <field name="arch" type="xml">

            <!-- Inject domain widgets inside the <group> -->
            <xpath expr="//form/sheet/group" position="inside">

                <!-- Domain widget for the 'worker' types -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.registry.worker', 'allowed_fields': ['priority_rank']}"
                       invisible="target_registry != 'worker'"/>

                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.registry.monthly.attendance', 'allowed_fields': ['priority_rank']}"
                       invisible="target_registry != 'monthly_attendance'"/>

                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.registry.monthly.availability', 'allowed_fields': ['priority_rank']}"
                       invisible="target_registry != 'monthly_availability'"/>

            </xpath>
        </field>
    </record>
</odoo>
