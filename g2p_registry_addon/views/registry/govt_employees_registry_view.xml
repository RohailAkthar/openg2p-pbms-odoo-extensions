<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_g2p_govt_employees_registry" model="ir.actions.act_window">
        <field name="name">Government Employees Registry</field>
        <field name="res_model">g2p.registry.govt.employees</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="view_g2p_govt_employees_registry_form" model="ir.ui.view">
        <field name="name">g2p.registry.govt.employees.form</field>
        <field name="model">g2p.registry.govt.employees</field>
        <field name="arch" type="xml">
            <form string="G2P Government Employees Registry">
                <sheet>
                    <group>
                        <field name="id"/>
                        <field name="link_registry_id"/>
                        <field name="individual_registry_id"/>
                        <field name="individual_unique_id"/>
                        <field name="aadhaar"/>
                        <field name="family_unique_id"/>
                        <field name="family_registry_id"/>
                        <field name="government_employee_id"/>
                        <field name="government_department"/>
                        <field name="employee_since_date"/>
                        <field name="type_of_department"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_g2p_govt_employees_registry_tree" model="ir.ui.view">
        <field name="name">g2p.registry.govt.employees.tree</field>
        <field name="model">g2p.registry.govt.employees</field>
        <field name="arch" type="xml">
            <tree string="G2P Government Employees Registry">
                <field name="id"/>
                <field name="link_registry_id"/>
                <field name="individual_registry_id"/>
                <field name="individual_unique_id"/>
                <field name="aadhaar"/>
                <field name="family_unique_id"/>
                <field name="family_registry_id"/>
                <field name="government_employee_id"/>
                <field name="government_department"/>
                <field name="employee_since_date"/>
                <field name="type_of_department"/>
                <button name="action_open_view" type="object" class="fa fa-eye" title="View"/>
            </tree>
        </field>
    </record>
</odoo>
