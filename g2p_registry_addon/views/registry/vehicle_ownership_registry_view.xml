<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_g2p_vehicle_ownership_registry" model="ir.actions.act_window">
        <field name="name">Vehicle Ownership Registry</field>
        <field name="res_model">g2p.registry.vehicle.ownership</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="view_g2p_vehicle_ownership_registry_form" model="ir.ui.view">
        <field name="name">g2p.registry.vehicle.ownership.form</field>
        <field name="model">g2p.registry.vehicle.ownership</field>
        <field name="arch" type="xml">
            <form string="G2P Vehicle Ownership Registry">
                <sheet>
                    <group>
                        <field name="id"/>
                        <field name="link_registry_id"/>
                        <field name="vehicle_registration_id"/>
                        <field name="individual_registry_id"/>
                        <field name="individual_unique_id"/>
                        <field name="owner_aadhaar"/>
                        <field name="family_unique_id"/>
                        <field name="family_registry_id"/>
                        <field name="class_of_vehicle"/>
                        <field name="number_of_wheels"/>
                        <field name="registration_from_date"/>
                        <field name="registration_to_date"/>
                        <field name="engine_no"/>
                        <field name="chassis_no"/>
                        <field name="manufacturer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_g2p_vehicle_ownership_registry_tree" model="ir.ui.view">
        <field name="name">g2p.registry.vehicle.ownership.tree</field>
        <field name="model">g2p.registry.vehicle.ownership</field>
        <field name="arch" type="xml">
            <tree string="G2P Vehicle Ownership Registry">
                <field name="id"/>
                <field name="link_registry_id"/>
                <field name="vehicle_registration_id"/>
                <field name="individual_registry_id"/>
                <field name="individual_unique_id"/>
                <field name="owner_aadhaar"/>
                <field name="family_unique_id"/>
                <field name="family_registry_id"/>
                <field name="class_of_vehicle"/>
                <field name="number_of_wheels"/>
                <field name="registration_from_date"/>
                <field name="registration_to_date"/>
                <field name="engine_no"/>
                <field name="chassis_no"/>
                <field name="manufacturer"/>
                <button name="action_open_view" type="object" class="fa fa-eye" title="View"/>
            </tree>
        </field>
    </record>
</odoo>
