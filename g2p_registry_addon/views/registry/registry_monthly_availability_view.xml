<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_g2p_registry_monthly_availability" model="ir.actions.act_window">
        <field name="name">Registry Monthly Availability</field>
        <field name="res_model">g2p.registry.monthly.availability</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="view_g2p_registry_monthly_availability_form" model="ir.ui.view">
        <field name="name">g2p.registry.monthly.availability.form</field>
        <field name="model">g2p.registry.monthly.availability</field>
        <field name="arch" type="xml">
            <form string="G2P Registry Monthly Availability">
                <sheet>
                    <group>
                        <field name="unique_id"/>
                        <field name="name"/>
                        <field name="attendance_month"/>
                        <field name="attendance_month_str"/>
                        <field name="source_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_g2p_registry_monthly_availability_tree" model="ir.ui.view">
        <field name="name">g2p.registry.monthly.availability.tree</field>
        <field name="model">g2p.registry.monthly.availability</field>
        <field name="arch" type="xml">
            <tree string="G2P Registry Monthly Availability">
                <field name="unique_id"/>
                <field name="name"/>
                <field name="attendance_month"/>
                <field name="attendance_month_str"/>
                <field name="source_type"/>
            </tree>
        </field>
    </record>
</odoo>