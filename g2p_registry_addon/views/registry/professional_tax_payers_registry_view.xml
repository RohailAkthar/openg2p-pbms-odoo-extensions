<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_g2p_professional_tax_payers_registry" model="ir.actions.act_window">
        <field name="name">Professional Tax Payers Registry</field>
        <field name="res_model">g2p.registry.professional.tax.payers</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="view_g2p_professional_tax_payers_registry_form" model="ir.ui.view">
        <field name="name">g2p.registry.professional.tax.payers.form</field>
        <field name="model">g2p.registry.professional.tax.payers</field>
        <field name="arch" type="xml">
            <form string="G2P Professional Tax Payers Registry">
                <sheet>
                    <group>
                        <field name="id"/>
                        <field name="link_registry_id"/>
                        <field name="individual_registry_id"/>
                        <field name="individual_unique_id"/>
                        <field name="aadhaar_id"/>
                        <field name="family_unique_id"/>
                        <field name="family_registry_id"/>
                        <field name="professional_tax_payer_id"/>
                        <field name="type_of_business"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_g2p_professional_tax_payers_registry_tree" model="ir.ui.view">
        <field name="name">g2p.registry.professional.tax.payers.tree</field>
        <field name="model">g2p.registry.professional.tax.payers</field>
        <field name="arch" type="xml">
            <tree string="G2P Professional Tax Payers Registry">
                <field name="id"/>
                <field name="link_registry_id"/>
                <field name="individual_registry_id"/>
                <field name="individual_unique_id"/>
                <field name="aadhaar_id"/>
                <field name="family_unique_id"/>
                <field name="family_registry_id"/>
                <field name="professional_tax_payer_id"/>
                <field name="type_of_business"/>
                <button name="action_open_view" type="object" class="fa fa-eye" title="View"/>
            </tree>
        </field>
    </record>
</odoo>
