<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_g2p_registry_worker" model="ir.actions.act_window">
        <field name="name">Registry Worker</field>
        <field name="res_model">g2p.registry.worker</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="view_g2p_registry_worker_form" model="ir.ui.view">
        <field name="name">g2p.registry.worker.form</field>
        <field name="model">g2p.registry.worker</field>
        <field name="arch" type="xml">
            <form string="G2P Registry Worker">
                <sheet>
                    <group>
                        <field name="link_registry_id"/>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="province_id"/>
                        <field name="district_id"/>
                        <field name="constituency_id"/>
                        <field name="ward_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_g2p_registry_worker_tree" model="ir.ui.view">
        <field name="name">g2p.registry.worker.tree</field>
        <field name="model">g2p.registry.worker</field>
        <field name="arch" type="xml">
            <tree string="G2P Registry Worker">
                <field name="link_registry_id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="province_id"/>
                <field name="district_id"/>
                <field name="constituency_id"/>
                <field name="ward_id"/>
            </tree>
        </field>
    </record>
</odoo>