<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_g2p_individual_registry" model="ir.actions.act_window">
        <field name="name">Individual Registry</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="view_g2p_individual_registry_form" model="ir.ui.view">
        <field name="name">g2p.individual.registry.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="G2P Individual Registry" create="0">
                <sheet>
                    <group>
                        <field name="id" readonly="1"/>
                        <field name="name"/>
                        <field name="birthdate"/>
                        <field name="age"/>
                        <field name="gender"/>
                        
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_g2p_individual_registry_tree" model="ir.ui.view">
        <field name="name">g2p.individual.registry.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="G2P Individual Registry" create="0">
                <field name="id"/>
                <field name="name"/>
                <field name="birthdate"/>
                <field name="age"/>
                <field name="gender"/>
            </tree>
        </field>
    </record>
</odoo>