    <record id="view_g2p_individual_registry_form_custom" model="ir.ui.view">
        <field name="name">g2p.individual.registry.form_custom</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="model">res.partner</field>
        <!-- <field name="context">{'default_is_registrant': True}</field> -->
        <field name="arch" type="xml">
            <xpath expr="//form" position="replace">
            <form string="G2P Individual Registry" create="0">
                <sheet>
                    <group>
                        <field name="id" readonly="1"/>
                        <field name="name"/>
                        <field name="birthdate"/>
                        <field name="age"/>
                        <field name="gender"/>
                        
                    </group>
                </sheet>
            </form>
            </xpath>
        </field>
    </record>
    <!-- <record id="base.view_partner_tree" model="ir.ui.view">
