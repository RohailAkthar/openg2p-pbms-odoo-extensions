<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_g2p_ration_card_applicants_registry" model="ir.actions.act_window">
        <field name="name">Ration Card Applicants Registry</field>
        <field name="res_model">g2p.registry.ration.card.applicants</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="view_g2p_ration_card_applicants_registry_form" model="ir.ui.view">
        <field name="name">g2p.registry.ration.card.applicants.form</field>
        <field name="model">g2p.registry.ration.card.applicants</field>
        <field name="arch" type="xml">
            <form string="G2P Ration Card Applicants Registry">
                <sheet>
                    <group>
                        <field name="id"/>
                        <field name="link_registry_id"/>
                        <field name="ration_card_application_id"/>
                        <field name="individual_registry_id"/>
                        <field name="individual_unique_id"/>
                        <field name="aadhaar_id"/>
                        <field name="family_unique_id"/>
                        <field name="family_registry_id"/>
                        <field name="application_date"/>
                        <field name="verified_by"/>
                        <field name="verification_time_stamp"/>
                        <field name="application_channel"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_g2p_ration_card_applicants_registry_tree" model="ir.ui.view">
        <field name="name">g2p.registry.ration.card.applicants.tree</field>
        <field name="model">g2p.registry.ration.card.applicants</field>
        <field name="arch" type="xml">
            <tree string="G2P Ration Card Applicants Registry">
                <field name="id"/>
                <field name="link_registry_id"/>
                <field name="ration_card_application_id"/>
                <field name="individual_registry_id"/>
                <field name="individual_unique_id"/>
                <field name="aadhaar_id"/>
                <field name="family_unique_id"/>
                <field name="family_registry_id"/>
                <field name="application_date"/>
                <field name="verified_by"/>
                <field name="verification_time_stamp"/>
                <field name="application_channel"/>
                <button name="action_open_view" type="object" class="fa fa-eye" title="View"/>
            </tree>
        </field>
    </record>
</odoo>
