<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_g2p_registry_monthly_attendance" model="ir.actions.act_window">
        <field name="name">Registry Monthly Attendance</field>
        <field name="res_model">g2p.registry.monthly.attendance</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="view_g2p_registry_monthly_attendance_form" model="ir.ui.view">
        <field name="name">g2p.registry.monthly.attendance.form</field>
        <field name="model">g2p.registry.monthly.attendance</field>
        <field name="arch" type="xml">
            <form string="G2P Registry Monthly Attendance">
                <sheet>
                    <group>
                        <field name="unique_id"/>
                        <field name="nrc_number"/>
                        <field name="attendance_month"/>
                        <field name="number_of_days"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_g2p_registry_monthly_attendance_tree" model="ir.ui.view">
        <field name="name">g2p.registry.monthly.attendance.tree</field>
        <field name="model">g2p.registry.monthly.attendance</field>
        <field name="arch" type="xml">
            <tree string="G2P Registry Monthly Attendance">
                <field name="unique_id"/>
                <field name="nrc_number"/>
                <field name="attendance_month"/>
                <field name="number_of_days"/>
            </tree>
        </field>
    </record>
</odoo>