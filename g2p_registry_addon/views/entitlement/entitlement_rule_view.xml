<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_entitlement_rule_definition_form_inherit" model="ir.ui.view">
        <field name="name">g2p.entitlement.rule.definition.form.inherit</field>
        <field name="model">g2p.entitlement.rule.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_entitlement_rule_definition_form"/>
        <field name="arch" type="xml">

            <!-- Inject domain widgets inside the <group> -->
            <!-- Hide base dynamic domain if Individual is selected (to use filtered one below) -->
            <xpath expr="//field[@name='pbms_domain']" position="attributes">
                <attribute name="invisible">target_registry == 'individual'</attribute>
            </xpath>

            <!-- Inject filtered domain widget for 'Individual' type -->
            <xpath expr="//field[@name='pbms_domain']" position="after">
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'res.partner', 'allowed_fields': ['name', 'gender', 'birthdate', 'age', 'street', 'city', 'state_id', 'country_id', 'zip', 'email', 'phone', 'mobile', 'active']}"
                       invisible="target_registry != 'individual'"/>
            </xpath>
        </field>
    </record>
</odoo>
