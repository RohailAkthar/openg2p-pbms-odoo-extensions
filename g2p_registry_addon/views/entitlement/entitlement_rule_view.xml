<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_entitlement_rule_definition_form_inherit" model="ir.ui.view">
        <field name="name">g2p.entitlement.rule.definition.form.inherit</field>
        <field name="model">g2p.entitlement.rule.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_entitlement_rule_definition_form"/>
        <field name="arch" type="xml">

            <!-- Inject domain widgets inside the <group> -->
            <xpath expr="//form/sheet/group" position="inside">

                <!-- Domain widget for the 'farmer' type -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.farmer.registry'}"
                       invisible="target_registry != 'farmer'"/>

                <!-- Domain widget for the 'student' type -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.student.registry'}"
                       invisible="target_registry != 'student'"/>

                <!-- Domain widget for the 'worker' types -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.worker.registry'}"
                       invisible="target_registry != 'worker'"/>

                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.worker.daily.registry'}"
                       invisible="target_registry != 'worker_daily'"/>

                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.worker.monthly.registry'}"
                       invisible="target_registry != 'worker_monthly'"/>

            </xpath>
        </field>
    </record>
</odoo>
