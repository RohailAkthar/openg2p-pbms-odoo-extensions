<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- NSR Database Connection Parameters -->
        <!-- These can be overridden from Settings → Technical → System Parameters -->
        <!--
            NOTE: Password is NOT stored here for security reasons.
            It is read from the NSR_DB_PASSWORD environment variable,
            which should be mounted from K8s secret 'nsr' key 'nsr-db-user'
            in the PBMS Odoo deployment.
        -->
        <record id="nsr_db_host" model="ir.config_parameter">
            <field name="key">g2p_registry_addon.nsr_db_host</field>
            <field name="value">commons-postgresql</field>
        </record>
        <record id="nsr_db_port" model="ir.config_parameter">
            <field name="key">g2p_registry_addon.nsr_db_port</field>
            <field name="value">5432</field>
        </record>
        <record id="nsr_db_name" model="ir.config_parameter">
            <field name="key">g2p_registry_addon.nsr_db_name</field>
            <field name="value">nsr</field>
        </record>
        <record id="nsr_db_user" model="ir.config_parameter">
            <field name="key">g2p_registry_addon.nsr_db_user</field>
            <field name="value">nsr_user</field>
        </record>
    </data>
</odoo>

