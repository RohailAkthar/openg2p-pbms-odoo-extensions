<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dashboard_template" name="PBMS Dashboard Template">
        <t t-call="web.layout">
            <t t-set="head">
                <title>PBMS Dashboard</title>
            </t>
            <div id="dashboard_container"></div>
            <script type="text/javascript">
                odoo.define('g2p_pbms_dashboard.loader', function (require) {
                    var WebClient = require('web.WebClient');
                    var action = {
                        type: 'ir.actions.client',
                        tag: 'pbms_dashboard_main',
                        params: {dashboard_type: <t t-esc="dashboard_type"/>},
                    };
                    return WebClient.prototype.action_manager.do_action(action);
                });
            </script>
        </t>
    </template>

    <template id="dashboard_access_denied" name="PBMS Dashboard Access Denied">
        <t t-call="web.layout">
            <div style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:2rem;background:#f8fafc;">
                <div style="max-width:560px;width:100%;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 8px 24px rgba(15,23,42,0.08);padding:2rem;text-align:center;">
                    <h2 style="margin:0 0 0.75rem 0;color:#0f172a;font-size:1.5rem;">Access Denied</h2>
                    <p style="margin:0;color:#334155;font-size:1rem;">
                        You do not have access to view the dashboard.
                    </p>
                </div>
            </div>
        </t>
    </template>
</odoo>
