<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <!-- Main Dashboard Action for dedicated URL access -->
   <record id="pbms_dashboard_action" model="ir.actions.client">
      <field name="name">PBMS Dashboard</field>
      <field name="tag">pbms_dashboard_main</field>
      <field name="context">{'dashboard_type': 'beneficiary'}</field>
   </record>

   <menuitem
        name="Dashboard"
        id="menu_pbms_dashboard"
        sequence="0"
        parent="g2p_pbms.menu_g2p_root"
        action="pbms_dashboard_action"
        groups="g2p_pbms_dashboard.group_dashboard_viewer"
    />
</odoo>
