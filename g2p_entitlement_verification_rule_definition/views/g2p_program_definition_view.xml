<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_programs_form_inherit_entitlement" model="ir.ui.view">
        <field name="name">g2p.programs.form.inherit.entitlement</field>
        <field name="model">g2p.program.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_programs_form"/>
        <field name="arch" type="xml">
            <!-- Target the Enrollment Configuration group by checking for a unique field inside it -->
            <xpath expr="//group[field[@name='verifications_for_enrolment']]" position="inside">
                <separator string="Entitlement Verification Configuration" colspan="2"/>
                <field name="entitlement_verification_ids" nolabel="1" colspan="2">
                    <tree editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="state"/>
                        <field name="group_id"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
