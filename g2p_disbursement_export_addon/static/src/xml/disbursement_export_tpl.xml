<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="g2p_registry_addon.g2p_beneficiaries_info_tpl" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o_x2m_control_panel')]" position="inside">
            <t t-if="state.isDisbursement">
                <button type="button" class="btn btn-primary ms-2" t-on-click="downloadBeneficiariesCSV" title="Download Beneficiaries CSV">
                    <i class="fa fa-download me-1"/> Download Beneficiaries
                </button>
            </t>
        </xpath>
    </t>
</templates>
