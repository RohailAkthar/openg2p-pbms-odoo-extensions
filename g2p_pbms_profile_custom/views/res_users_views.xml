<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Override the Groups menu item to remove base.group_no_one restriction.
        This makes it visible in normal mode for users with Administration/Settings access.
    -->
    <menuitem name="Groups"
              id="base.menu_action_res_groups"
              parent="base.menu_users"
              action="base.action_res_groups"
              groups="base.group_erp_manager"
              sequence="3"/>
    <!-- 
        Restrict "Change Password" action to form view only.
        This hides it from the list view "Actions" menu but keeps it in the form view gear icon.
    -->
    <record id="base.change_password_wizard_action" model="ir.actions.act_window">
        <field name="binding_view_types">form</field>
    </record>

    <record id="change_password_wizard_view_vertical" model="ir.ui.view">
        <field name="name">change.password.wizard.view.vertical</field>
        <field name="model">change.password.wizard</field>
        <field name="inherit_id" ref="base.change_password_wizard_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="invisible">user_id_display != False</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="before">
                <group invisible="not user_id_display">
                    <field name="user_id_display" invisible="1"/>
                    <field name="user_id_display"/>
                    <field name="user_login_display"/>
                    <field name="new_passwd_display" password="True" default_focus="1" style="width: 250px;"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
