<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- ADMINISTRATION section of the sidebar (below WORKSPACE). Only rendered for PBMS super
         administrators; see admin_sidebar.js. -->
    <t t-name="pbms_rbac_nigeria.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav" position="inside">
            <div class="nsipa_admin d-none d-md-block" t-if="nsipaAdminLinks.length">
                <div class="nsipa_sidebar_caption">ADMINISTRATION</div>
                <a t-foreach="nsipaAdminLinks" t-as="link" t-key="link.key"
                   class="nsipa_admin_link"
                   t-att-class="{ nsipa_active: link.active }"
                   t-att-href="link.href"
                   t-on-click="(ev) => this._nsipaOpenAdminLink(ev, link)">
                    <t t-esc="link.label"/> ↗
                </a>
            </div>
        </xpath>
    </t>
</templates>
