<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- User page: no Groups / Access Rights / Record Rules buttons and no Related Partner,
         also in debug mode. Fields and their logic are unchanged. -->
    <record id="view_users_form_rbac" model="ir.ui.view">
        <field name="name">res.users.form.pbms.rbac</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <button name="action_show_groups" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_show_accesses" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_show_rules" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <xpath expr="//div[hasclass('oe_title')]//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Account Security tab also while creating a user (Odoo shows it only once saved). For a new
         user it offers an optional initial password; two-factor authentication is switched on by
         the user after their first sign-in, as before. -->
    <record id="view_users_form_rbac_security" model="ir.ui.view">
        <field name="name">res.users.form.pbms.rbac.security</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="auth_totp.view_totp_form"/>
        <field name="arch" type="xml">
            <page name="security" position="attributes">
                <attribute name="invisible">0</attribute>
            </page>
            <!-- Odoo's two-factor block needs a saved user: hidden until then (the note below says why). -->
            <xpath expr="//page[@name='security']/div" position="attributes">
                <attribute name="invisible">not id</attribute>
            </xpath>
            <xpath expr="//page[@name='security']/field[@name='totp_enabled']" position="after">
                <group name="pbms_rbac_new_user_security" string="Sign-in" invisible="id">
                    <field name="password" password="True" string="Initial password"
                           placeholder="Optional - leave empty to send an invitation instead"/>
                </group>
                <div class="text-muted nsipa_rbac_security_note" invisible="id">
                    Two-factor authentication can be switched on by the user after their first sign-in.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Access Rights tab: only the OpenG2P PBMS and OpenG2P Documents Module role checkboxes,
         with or without debug mode. Generated by res.groups._pbms_rbac_update_views() because the
         field names depend on the database's group ids; this is only the initial placeholder. -->
    <record id="view_users_form_rbac_roles" model="ir.ui.view">
        <field name="name">res.users.groups.pbms.rbac.roles</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.user_groups_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <data/>
        </field>
    </record>

    <!-- "New user" pop-up: the same user form as the user page (Name, Email, Access Rights with
         Administration + PBMS + Documents roles, Preferences, Account Security), in a dialog with
         Odoo's Save / Discard buttons at the bottom. -->
    <record id="action_res_users_new_popup" model="ir.actions.act_window">
        <field name="name">New user</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_users_form"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'large'}</field>
    </record>

    <!-- Fill both generated views now (on install and on every upgrade). -->
    <function model="res.groups" name="_pbms_rbac_update_views"/>
</odoo>
